{
  "name": "dsh-bundle-template-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pnpm monorepo starter for a DeepSeek Harness bundle: one meta-package and one package per plugin.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "clean": "node scripts/clean.ts",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "node scripts/check-pack.ts",
    "check": "pnpm typecheck && pnpm build && pnpm pack:check",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  }
}
