    },
    {
      "id": "el-1por49e",
      "type": "text",
      "x": 40,
      "y": 628,
      "width": 1102.9999999999993,
      "height": 25,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 12516163,
      "version": 1,
      "versionNonce": 572820919,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "根因：一个概念单位（组件）被三套子系统用三种键识别。单包内无法同时做到「独立行 + 独立 Client + 独立元数据」。",
      "originalText": "根因：一个概念单位（组件）被三套子系统用三种键识别。单包内无法同时做到「独立行 + 独立 Client + 独立元数据」。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "el-1xyied1",
      "type": "text",
      "x": 40,
      "y": 664,
      "width": 1049.5999999999995,
      "height": 20,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 468097792,
      "version": 1,
      "versionNonce": 911015450,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "dsh-hyper-mode 选了「相对路径 + 嵌套 package.json」：Host 行与 Client 半边都能独立，代价是第三列的行级元数据退化为 bundle 级。",
      "originalText": "dsh-hyper-mode 选了「相对路径 + 嵌套 package.json」：Host 行与 Client 半边都能独立，代价是第三列的行级元数据退化为 bundle 级。",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "el-wgoqa7",
      "type": "text",
      "x": 40,
      "y": 694,
      "width": 850.3999999999994,
      "height": 20,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1557331677,
      "version": 1,
      "versionNonce": 866849512,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "要三列全绿，只有两条路：让每组件成为真正安装的包（多包分发），或改 DSH 核心给行加 Client/元数据级扩展点。",
      "originalText": "要三列全绿，只有两条路：让每组件成为真正安装的包（多包分发），或改 DSH 核心给行加 Client/元数据级扩展点。",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "containerId": null,
      "autoResize": true
    }
  ],
