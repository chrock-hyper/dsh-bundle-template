      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "⚠️ 同一份\n所有行共用同一个\npackage.json / locale",
      "originalText": "⚠️ 同一份\n所有行共用同一个\npackage.json / locale",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "lineHeight": 1.25,
