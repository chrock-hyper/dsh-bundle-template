{
  "name": "@dsh-bundle-template/bundle",
  "version": "0.1.0",
  "type": "module",
  "description": "Composes the echo tool and badge plugins into one installable bundle.",
  "license": "MIT",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-bundle-template/echo": "workspace:*",
    "@dsh-bundle-template/badge": "workspace:*"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=24.9.0"
  }
}
